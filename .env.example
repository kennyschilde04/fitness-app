# Google-Login als Sperre vor "Kennys Plan".
# Ohne diese Werte bleibt die Option gesperrt und meldet, dass keine
# Client-ID hinterlegt ist.
#
# Kopiere die Datei nach .env.local und trage deine Werte ein.

# OAuth-Client-ID aus der Google Cloud Console (Typ: Web-Anwendung)
VITE_GOOGLE_CLIENT_ID=

# Nur diese Google-Adresse schaltet den Plan frei.
# Leer lassen = jede erfolgreich angemeldete Adresse schaltet frei.
VITE_PLAN_OWNER_EMAIL=
